universe=vanilla
executable=runjob.sh
arguments= $(input_dir) $(output_file) $(stderr_file) $(crossection)

output=logs/$(ClusterId).out
error=logs/$(ClusterId).err
log=logs/$(ClusterId).log

should_transfer_files=YES
transfer_input_files= ,runjob.sh,jobconfiganalysis_new.py,processnanoaod.py,sample_list.txt,submitanalysisjob.py,job.submit,libnanoadrdframe.so,rootdict_rdict.pcm,package.tar.gz

when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=8 GB
request_disk= 20 GB

queue input_dir, output_file, stderr_file,crossection from sample_list.txt
