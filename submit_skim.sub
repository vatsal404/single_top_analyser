# Condor submit file for skimming jobs
universe              = vanilla
executable            = run_skim.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files  = skim_package.tar.gz

# Resource requirements
request_cpus   = 1
request_memory = 4GB
request_disk   = 10GB

# Job requirements

# X509 user proxy for grid access
use_x509userproxy = true

# Logs directory - make sure this exists!
log    = logs/skim_$(Cluster)_$(Process).log
output = logs/skim_$(Cluster)_$(Process).out
error  = logs/skim_$(Cluster)_$(Process).err

# Arguments: only batch_file (duplicate file is auto-detected)
arguments = $(batch_file)

# Queue jobs from the sample list
# Column 1: batch file path
queue batch_file from sample_list_split_data.txt
