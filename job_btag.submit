universe=vanilla
executable=runbtagefficiency_job.sh
arguments= $(dataset) $(outputfile) $(error_file)

output=logs/$(ClusterId).out
error=logs/$(ClusterId).err
log=logs/$(ClusterId).log

should_transfer_files=YES
transfer_input_files= runbtagefficiency_job.sh,job_btag.submit,sample_list_btag.txt,libnanoadrdframe.so,rootdict_rdict.pcm,runEfficiencyCalc.C

when_to_transfer_output=ON_EXIT_OR_EVICT

request_cpus=1
request_memory=5 GB
request_disk= 5 GB

queue dataset, outputfile, error_file from sample_list_btag.txt

